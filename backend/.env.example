# Copy this file to `.env` and fill it in. `.env` is git-ignored; this file is not.

ENVIRONMENT=development

# Neon gives you a URL like postgresql://user:pass@host/dbname?sslmode=require
# Paste it as-is; the app rewrites it for the psycopg driver automatically.
# Use the DIRECT host (no "-pooler") for now.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wwyd

# REQUIRED. Signs login tokens; anyone who knows it can forge a login.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a DIFFERENT value in production.
JWT_SECRET=

BACKEND_URL=http://127.0.0.1:8010


# Login lifetime in minutes (default 10080 = 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Login/register attempts allowed per IP per minute.
# AUTH_RATE_LIMIT_PER_MINUTE=10

# A SEPARATE, disposable database used only by `pytest`. The test suite wipes and
# rebuilds every table in it, so the database name must contain "test".
# TEST_DATABASE_URL=postgresql://user:pass@host/wwyd_test

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# Game rules
ROUND_LENGTH=10
MIN_STATS_SAMPLE=20
